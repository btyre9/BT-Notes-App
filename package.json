{
  "name": "bt-notes",
  "productName": "BT Notes",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown notes with Bear's look, synced through a cloud folder.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "mcp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON mcp/server.ts",
    "import-notes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON mac/import-apple-notes.ts",
    "import-notes:install": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON mac/schedule.ts install",
    "import-notes:uninstall": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON mac/schedule.ts uninstall",
    "import-notes:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON mac/schedule.ts status"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide": "^1.50.0",
    "marked": "^18.1.1",
    "mermaid": "^12.1.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.4.299",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.5"
  },
  "author": "Brian Tyre",
  "build": {
    "appId": "com.btyre.btnotes",
    "productName": "BT Notes",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "BT Notes"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "node_modules/pdfjs-dist",
        "to": "pdfjs",
        "filter": [
          "wasm/**",
          "cmaps/**",
          "standard_fonts/**",
          "iccs/**"
        ]
      }
    ]
  }
}
